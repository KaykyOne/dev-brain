DATABASE_URL=postgresql://gulosos:gulosos@localhost:5432/gulosos

# URL pública do app. É a fonte única do prefixo (basePath): o caminho de APP_URL vira o basePath do Next
# (ex.: https://vps.kayky.dev.br/ai -> /ai). Fixado no build: ao mudar, rebuild (npm run up).
# Também é a base dos endpoints MCP exibidos em /mcp.
APP_URL=https://vps.kayky.dev.br/ai

# Opcionais (valores padrão abaixo)
# Pasta dos repositórios git de contexto (um por projeto). Em produção use um volume (no Docker: /data/context-repos).
# CONTEXT_REPOS_DIR=./data/context-repos
# (No Docker o compose fixa /data/context-repos, o volume; este valor só vale fora do Docker.)
# Usuário criado na inicialização se não existir (a senha só vale na criação; altere no perfil)
# ADMIN_EMAIL=kaykyzioti@gmail.com
# ADMIN_NAME="Kayky Zioti"
# ADMIN_INITIAL_PASSWORD=Senha123?
# Chave que cifra a chave de acesso do MCP no banco (32 bytes em base64: openssl rand -base64 32).
# Sem ela, uma é gerada em CONTEXT_REPOS_DIR/.secrets/token.key na primeira vez.
# TOKEN_ENCRYPTION_KEY=
# SESSION_COOKIE_NAME=session
# SESSION_MAX_AGE_DAYS=7

# Docker Compose (opcionais; valores padrão abaixo). A senha do banco deve ser trocada em produção.
# POSTGRES_USER=gulosos
# POSTGRES_PASSWORD=gulosos
# POSTGRES_DB=gulosos
# APP_PORT=3000

# Assistente de IA: configure em Configurações → Assistente de IA, no painel. As variáveis abaixo são só o valor
# inicial, usado enquanto nada for salvo lá (no primeiro salvamento, a chave daqui é levada para o painel).
# AI_API_KEY=
# AI_PROVIDER=deepseek        # deepseek | openai | openrouter | custom (qualquer API compatível com a da OpenAI)
# AI_MODEL=deepseek-flash     # obrigatório fora do DeepSeek
# AI_BASE_URL=                # só para AI_PROVIDER=custom, ou para sobrescrever a URL do provedor
# AI_THINKING=disabled        # enabled liga o modo de raciocínio do DeepSeek (mais lento e caro)
# AI_MAX_STEPS=12             # máximo de rodadas de ferramentas por mensagem
